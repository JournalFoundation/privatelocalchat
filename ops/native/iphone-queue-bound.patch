+
+// Numeric counters cover graph command batches; they are not GPU/process residency.
+extern "C" void plc_webgpu_queue_counters(uint64_t * out) {
+    for (size_t i = 0; i < 9; ++i) out[i] = 0;
+    if (st_flight_last_sync_ctx == nullptr) return;
+    const auto & ctx = *(webgpu_global_context *) st_flight_last_sync_ctx;
+    out[0] = ctx->plc_submitted; out[1] = ctx->plc_completed;
+    out[2] = ctx->plc_inflight_peak; out[3] = ctx->plc_waits;
+    out[4] = ctx->plc_wait_us; out[5] = ctx->plc_graphs;
+    out[6] = ctx->max_inflight_batches; out[7] = ctx->command_submit_batch_size;
+    out[8] = ctx->plc_submitted - ctx->plc_completed;
+}
